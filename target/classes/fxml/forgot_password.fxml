<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ForgotPasswordController"
            style="-fx-background-color: #f5f7fb;">

    <!-- ===== LEFT SIDE (branding) ===== -->
    <left>
        <StackPane prefWidth="450"
                   style="-fx-background-color: linear-gradient(to bottom right, #1f4f65, #2e7d9f);">

            <VBox alignment="CENTER" spacing="12">

                <ImageView fx:id="logoImage"
                           fitWidth="120"
                           preserveRatio="true"/>

                <Label text="LearnFlexPlus"
                       style="-fx-text-fill: white; -fx-font-size: 26px; -fx-font-weight: bold;"/>

                <Label text="Réinitialiser votre mot de passe"
                       style="-fx-text-fill: #dfefff; -fx-font-size: 14px;"/>
            </VBox>
        </StackPane>
    </left>

    <!-- ===== RIGHT SIDE (form card) ===== -->
    <center>
        <StackPane>

            <VBox spacing="18"
                  alignment="CENTER"
                  maxWidth="420"
                  style="-fx-background-color: white;
                         -fx-padding: 35;
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0.2, 0, 6);">

                <!-- HEADER -->
                <VBox spacing="5" alignment="CENTER">
                    <Label text="Mot de passe oublié"
                           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f4f65;"/>

                    <Label text="Entrez votre email et choisissez un nouveau mot de passe"
                           style="-fx-text-fill: #777; -fx-font-size: 13px;"
                           wrapText="true"
                           maxWidth="320"
                           alignment="CENTER"/>
                </VBox>

                <!-- EMAIL -->
                <VBox spacing="6">
                    <Label text="Email"/>
                    <TextField fx:id="emailField"
                               promptText="Entrez votre email"
                               prefHeight="40"
                               style="-fx-background-radius: 10;"/>
                </VBox>

                <!-- NEW PASSWORD -->
                <VBox spacing="6">
                    <Label text="Nouveau mot de passe"/>
                    <PasswordField fx:id="newPasswordField"
                                   prefHeight="40"
                                   style="-fx-background-radius: 10;"/>
                </VBox>

                <!-- CONFIRM PASSWORD -->
                <VBox spacing="6">
                    <Label text="Confirmer le mot de passe"/>
                    <PasswordField fx:id="confirmPasswordField"
                                   prefHeight="40"
                                   style="-fx-background-radius: 10;"/>
                </VBox>

                <!-- BUTTON -->
                <Button text="Réinitialiser"
                        onAction="#resetPassword"
                        prefWidth="350"
                        prefHeight="45"
                        style="-fx-background-color: linear-gradient(to right, #1f4f65, #2e7d9f);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;"/>

                <!-- MESSAGE -->
                <Label fx:id="messageLabel"
                       style="-fx-text-fill: red;"/>

                <!-- BACK TO LOGIN -->
                <HBox alignment="CENTER">
                    <Label text="Retour à la connexion ? "/>

                    <Hyperlink text="Se connecter"
                               onAction="#goToLogin"
                               style="-fx-text-fill: #2e7d9f;"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>