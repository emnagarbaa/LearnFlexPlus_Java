<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="18" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.ForgotPasswordController"
      style="-fx-padding: 40; -fx-background-color: white;">

    <Label text="Réinitialisation du mot de passe"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <TextField fx:id="emailField"
               promptText="Entrez votre email"
               maxWidth="280"/>

    <PasswordField fx:id="newPasswordField"
                   promptText="Nouveau mot de passe"
                   maxWidth="280"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirmer le mot de passe"
                   maxWidth="280"/>

    <Button text="Réinitialiser"
            onAction="#resetPassword"
            style="-fx-background-color: #2e7d9f; -fx-text-fill: white;"
            maxWidth="280"/>

    <Label fx:id="messageLabel"
           style="-fx-text-fill: red;"/>
</VBox>