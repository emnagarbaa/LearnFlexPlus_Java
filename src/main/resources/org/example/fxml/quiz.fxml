<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Chargé dans le StackPane fx:id="mainContent" du Dashboard
    PAS de sidebar ici
    Controller : QuizController
-->

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.QuizController"
      spacing="0"
      style="-fx-background-color: #f0f2f5;">

    <!-- ================= HEADER ================= -->
    <HBox alignment="CENTER_LEFT"
          spacing="12"
          style="-fx-background-color: white;
                 -fx-padding: 14 22;
                 -fx-border-color: #e0e0e0;
                 -fx-border-width: 0 0 1 0;">

        <!-- Titre -->
        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Questionnaire"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #142341;"/>

            <Label text="Gérez vos quiz et questionnaires"
                   style="-fx-font-size: 12px; -fx-text-fill: #607d8b;"/>
        </VBox>

        <!-- Search -->
        <TextField fx:id="searchField"
                   promptText="Rechercher un quiz..."
                   prefWidth="210"
                   style="-fx-background-radius: 6;
                          -fx-border-color: #ddd;
                          -fx-border-radius: 6;
                          -fx-font-size: 13px;
                          -fx-padding: 7 11;"/>

        <Button text="Rechercher"
                onAction="#handleSearch"
                style="-fx-background-color: #142341;
                       -fx-text-fill: white;
                       -fx-background-radius: 6;
                       -fx-font-size: 13px;
                       -fx-padding: 7 13;
                       -fx-cursor: hand;
                       -fx-border-width: 0;"/>
    </HBox>

    <!-- ================= CONTENT ================= -->
    <ScrollPane fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background: transparent; -fx-background-color: transparent;">

        <content>
            <VBox spacing="16"
                  style="-fx-padding: 20 22;">

                <!-- TOOLBAR -->
                <HBox alignment="CENTER_LEFT" spacing="10">

                    <Label text="Gestion des Quiz"
                           HBox.hgrow="ALWAYS"
                           maxWidth="Infinity"
                           style="-fx-font-size: 16px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #142341;"/>

                    <Button text="+ Ajouter un quiz"
                            onAction="#ajouterQuiz"
                            style="-fx-background-color: #77af84;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 6;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 9 16;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0;"/>

                    <Button text="Exporter PDF"
                            onAction="#exporterPDF"
                            style="-fx-background-color: #142341;
                                   -fx-text-fill: white;
                                   -fx-background-radius: 6;
                                   -fx-font-size: 13px;
                                   -fx-font-weight: bold;
                                   -fx-padding: 9 16;
                                   -fx-cursor: hand;
                                   -fx-border-width: 0;"/>
                </HBox>

                <!-- MESSAGE -->
                <Label fx:id="messageLabel"
                       visible="false"
                       managed="false"
                       style="-fx-font-size: 13px;"/>

                <!-- TABLE -->
                <TableView fx:id="tableQuiz"
                           prefHeight="480"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 8;">

                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="colTitre" text="Titre" prefWidth="130"/>
                        <TableColumn fx:id="colQuestion" text="Question" prefWidth="180"/>
                        <TableColumn fx:id="colDuree" text="Durée (min)" prefWidth="90"/>
                        <TableColumn fx:id="colEtat" text="Active" prefWidth="80"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="280"/>
                    </columns>

                    <placeholder>
                        <Label text="Aucun quiz trouvé"
                               style="-fx-text-fill: #888; -fx-font-size: 14px;"/>
                    </placeholder>

                </TableView>

            </VBox>
        </content>

    </ScrollPane>

</VBox>