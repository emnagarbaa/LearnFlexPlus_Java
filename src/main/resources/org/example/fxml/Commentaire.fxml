<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CommentaireController"
      spacing="15" style="-fx-padding:20; -fx-min-width:700;">

    <Label fx:id="lblTitreExamen" style="-fx-font-size:16px; -fx-font-weight:bold;"/>

    <Button text="+ Ajouter un commentaire" onAction="#handleAjouter"
            style="-fx-background-color:#28a745; -fx-text-fill:white;
                   -fx-font-weight:bold; -fx-padding:8 20; -fx-background-radius:5;"/>

    <TableView fx:id="commentaireTable" prefHeight="400">
        <columns>
            <TableColumn fx:id="colContenu" text="Contenu"  prefWidth="300"/>
            <TableColumn fx:id="colAuteur"  text="Auteur"   prefWidth="120"/>
            <TableColumn fx:id="colDate"    text="Date"     prefWidth="120"/>
            <TableColumn fx:id="colLikes"   text="Likes"    prefWidth="80"/>
            <TableColumn fx:id="colActions" text="Actions"  prefWidth="160"/>
        </columns>
    </TableView>

    <Button text="Fermer" onAction="#handleFermer"
            style="-fx-padding:8 20; -fx-background-radius:5;"/>

</VBox>