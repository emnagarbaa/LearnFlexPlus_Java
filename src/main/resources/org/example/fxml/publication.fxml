<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.PublicationController"
      spacing="20" styleClass="publication-container"
      stylesheets="@../css/publication.css">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <!-- ===== HEADER SECTION ===== -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label text="📝" style="-fx-font-size: 32px;"/>
        <VBox>
            <Label text="Gestion des Publications" styleClass="page-title">
                <font>
                    <Font size="24" name="Segoe UI Bold"/>
                </font>
            </Label>
            <Label text="Créez, modifiez et gérez toutes les publications"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 13px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="statsLabel" styleClass="stats-label"/>
    </HBox>

    <!-- ===== FORMULAIRE D'AJOUT ===== -->
    <VBox styleClass="form-section" spacing="15">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="➕" style="-fx-font-size: 18px;"/>
            <Label text="Nouvelle publication" styleClass="section-title">
                <font><Font size="16" name="Segoe UI Bold"/></font>
            </Label>
        </HBox>

        <TextField fx:id="titreField" promptText="Titre de la publication" styleClass="input-field"/>
        <TextArea fx:id="descriptionArea" promptText="Description détaillée..."
                  prefHeight="100" styleClass="input-field" wrapText="true"/>
        <ComboBox fx:id="categorieCombo" promptText="Sélectionner une catégorie" styleClass="input-field"/>

        <HBox spacing="15">
            <Button fx:id="saveButton" text="Publier" onAction="#savePublication" styleClass="btn-primary"/>
            <Button text="Annuler" onAction="#clearForm" styleClass="btn-secondary"/>
        </HBox>
    </VBox>

    <!-- ===== BARRE DE RECHERCHE ET FILTRES ===== -->
    <VBox spacing="10">
        <HBox spacing="10">
            <TextField fx:id="searchField" promptText="🔍 Rechercher une publication..."
                       HBox.hgrow="ALWAYS" styleClass="search-field"/>
            <ComboBox fx:id="searchCriteriacombo" styleClass="search-combo"/>
            <Button text="Rechercher" onAction="#searchPublications" styleClass="btn-search"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label text="Trier par :" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
            <Button text="📅 Date récente" onAction="#sortByDate" styleClass="btn-sort"/>
            <Button text="👁️ Plus vues" onAction="#sortByViews" styleClass="btn-sort"/>
            <Button text="👍 Plus likées" onAction="#sortByLikes" styleClass="btn-sort"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="📄 Exporter PDF" onAction="#exportToPDF" styleClass="btn-export"/>
        </HBox>
    </VBox>

    <!-- ===== TABLEAU DES PUBLICATIONS ===== -->
    <VBox spacing="10" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="📋" style="-fx-font-size: 16px;"/>
            <Label text="Liste des publications" styleClass="section-title">
                <font><Font size="14" name="Segoe UI Bold"/></font>
            </Label>
        </HBox>

        <TableView fx:id="publicationTable" VBox.vgrow="ALWAYS" styleClass="publication-table">
            <placeholder>
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 40;">
                    <Label text="📭" style="-fx-font-size: 48px;"/>
                    <Label text="Aucune publication disponible"
                           style="-fx-text-fill: #95a5a6; -fx-font-size: 14px;"/>
                    <Label text="Cliquez sur 'Publier' pour ajouter votre première publication"
                           style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
                </VBox>
            </placeholder>
        </TableView>
    </VBox>

</VBox>