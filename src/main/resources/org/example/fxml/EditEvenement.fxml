<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>


<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.example.controllers.EditEvenementController"
           style="-fx-background-color:#f0f4f8;">

    <ScrollPane fitToWidth="true" style="-fx-background:transparent; -fx-background-color:transparent;">
        <VBox spacing="0">

            <!-- ══ HERO HEADER ══════════════════════════════════════════ -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color:linear-gradient(to right, #1f4f65, #2e7d9e);
                         -fx-padding:36 40 36 40;">
                <Label text="📅" style="-fx-font-size:42px;"/>
                <Label text="Modifier un Événement"
                       style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Label text="Remplissez les informations pour enregistrer un nouvel événement"
                       style="-fx-font-size:13px; -fx-text-fill:rgba(255,255,255,0.8);"/>
            </VBox>

            <!-- ══ BACK BUTTON BAR ══════════════════════════════════════ -->
            <HBox style="-fx-background-color:#ffffff; -fx-padding:12 32;
                         -fx-border-color:#e8ecf0; -fx-border-width:0 0 1 0;">
                <Button text="← Retour à la liste" onAction="#goBack"
                        style="-fx-background-color:transparent; -fx-text-fill:#1f4f65;
                               -fx-font-size:13px; -fx-font-weight:bold;
                               -fx-cursor:hand; -fx-border-color:#1f4f65;
                               -fx-border-radius:6; -fx-background-radius:6;
                               -fx-padding:6 16;"/>
            </HBox>

            <!-- ══ FORM BODY ════════════════════════════════════════════ -->
            <HBox spacing="24" style="-fx-padding:32 40;">

                <!-- LEFT CARD — Infos générales -->
                <VBox spacing="20" HBox.hgrow="ALWAYS"
                      style="-fx-background-color:white; -fx-background-radius:12;
                             -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),16,0,0,4);
                             -fx-padding:28;">

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📋" style="-fx-font-size:18px;"/>
                        <Label text="Informations générales"
                               style="-fx-font-size:15px; -fx-font-weight:bold; -fx-text-fill:#1f4f65;"/>
                    </HBox>
                    <Separator/>

                    <!-- Titre -->
                    <VBox spacing="4">
                        <Label text="Titre *"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                        <TextField fx:id="fTitre" promptText="Ex: Journée portes ouvertes"
                                   style="-fx-background-radius:8; -fx-border-radius:8;
                                          -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                        <Label fx:id="errTitre" text=""
                               style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                               visible="false" managed="false"/>
                    </VBox>

                    <!-- Mode -->
                    <VBox spacing="4">
                        <Label text="Mode *"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                        <ComboBox fx:id="fMode" maxWidth="Infinity" promptText="Sélectionner un mode"
                                  style="-fx-background-radius:8; -fx-border-radius:8;
                                         -fx-border-color:#dce3ea; -fx-padding:4 8; -fx-font-size:13px;"/>
                        <Label fx:id="errMode" text=""
                               style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                               visible="false" managed="false"/>
                    </VBox>

                    <!-- Lieu + Capacité -->
                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Lieu"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fLieu" promptText="Ex: Tunis"
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Capacité Max"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fCapaciteMax" promptText="Ex: 100"
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                            <Label fx:id="errCapaciteMax" text=""
                                   style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                                   visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <!-- Date Début + Date Fin -->
                    <HBox spacing="16">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Date Début"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fDateDebut" promptText="yyyy-MM-dd HH:mm"
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                            <Label fx:id="errDateDebut" text=""
                                   style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                                   visible="false" managed="false"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Date Fin"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fDateFin" promptText="yyyy-MM-dd HH:mm"
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                            <Label fx:id="errDateFin" text=""
                                   style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                                   visible="false" managed="false"/>
                        </VBox>
                    </HBox>

                    <!-- Public Cible -->
                    <VBox spacing="4">
                        <Label text="Public Cible"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                        <TextField fx:id="fPublicCible" promptText="Ex: Étudiants, Professionnels…"
                                   style="-fx-background-radius:8; -fx-border-radius:8;
                                          -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                    </VBox>

                    <!-- Description -->
                    <VBox spacing="4">
                        <Label text="Description"
                               style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                        <TextArea fx:id="fDescription" prefRowCount="4"
                                  promptText="Décrivez l'événement…"
                                  style="-fx-background-radius:8; -fx-border-radius:8;
                                         -fx-border-color:#dce3ea; -fx-padding:10 14; -fx-font-size:13px;"/>
                        <Label fx:id="errDescription" text=""
                               style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                               visible="false" managed="false"/>
                    </VBox>
                </VBox>

                <!-- RIGHT COLUMN -->
                <VBox spacing="24" prefWidth="300">

                    <!-- CARD — Contact & Inscription -->
                    <VBox spacing="16"
                          style="-fx-background-color:white; -fx-background-radius:12;
                                 -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),16,0,0,4);
                                 -fx-padding:24;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📞" style="-fx-font-size:16px;"/>
                            <Label text="Contact &amp; Inscription"
                                   style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1f4f65;"/>
                        </HBox>
                        <Separator/>

                        <VBox spacing="4">
                            <Label text="Email Contact"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fContactEmail" promptText="email@exemple.com"
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:9 12; -fx-font-size:13px;"/>
                            <Label fx:id="errContactEmail" text=""
                                   style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                                   visible="false" managed="false"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Téléphone Contact"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fContactTelephone" promptText="+216 XX XXX XXX"
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:9 12; -fx-font-size:13px;"/>
                            <Label fx:id="errContactTelephone" text=""
                                   style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                                   visible="false" managed="false"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Lien Inscription"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <TextField fx:id="fLienInscription" promptText="https://..."
                                       style="-fx-background-radius:8; -fx-border-radius:8;
                                              -fx-border-color:#dce3ea; -fx-padding:9 12; -fx-font-size:13px;"/>
                            <Label fx:id="errLienInscription" text=""
                                   style="-fx-text-fill:#e74c3c; -fx-font-size:11px;"
                                   visible="false" managed="false"/>
                        </VBox>
                    </VBox>

                    <!-- CARD — Organisme -->
                    <VBox spacing="16"
                          style="-fx-background-color:white; -fx-background-radius:12;
                                 -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),16,0,0,4);
                                 -fx-padding:24;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🏢" style="-fx-font-size:16px;"/>
                            <Label text="Organisme"
                                   style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1f4f65;"/>
                        </HBox>
                        <Separator/>
                        <VBox spacing="4">
                            <Label text="Organisme lié"
                                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
                            <ComboBox fx:id="fOrganisme" maxWidth="Infinity" promptText="Sélectionner…"
                                      style="-fx-background-radius:8; -fx-border-radius:8;
                                             -fx-border-color:#dce3ea; -fx-padding:4 8; -fx-font-size:13px;"/>
                        </VBox>
                    </VBox>

                    <!-- CARD — Options -->
                    <VBox spacing="16"
                          style="-fx-background-color:white; -fx-background-radius:12;
                                 -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),16,0,0,4);
                                 -fx-padding:24;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="⚙️" style="-fx-font-size:16px;"/>
                            <Label text="Options"
                                   style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill:#1f4f65;"/>
                        </HBox>
                        <Separator/>
                        <VBox spacing="12">
                            <CheckBox fx:id="fActif" text="✅  Événement actif"
                                      style="-fx-font-size:13px;"/>
                            <CheckBox fx:id="fInscriptionRequise" text="📝  Inscription requise"
                                      style="-fx-font-size:13px;"/>
                            <CheckBox fx:id="fGratuit" text="🎟  Événement gratuit"
                                      style="-fx-font-size:13px;"/>
                        </VBox>
                    </VBox>

                    <!-- Message erreur global -->
                    <Label fx:id="errorLabel" text="" wrapText="true"
                           style="-fx-text-fill:#c0392b; -fx-font-size:12px;
                                  -fx-background-color:#fdecea; -fx-background-radius:8;
                                  -fx-padding:10 14; -fx-border-color:#f5c6cb;
                                  -fx-border-radius:8;"
                           visible="false" managed="false"/>
                </VBox>
            </HBox>

            <!-- ══ ACTION BUTTONS ════════════════════════════════════════ -->
            <HBox alignment="CENTER_RIGHT" spacing="16"
                  style="-fx-background-color:white; -fx-padding:20 40;
                         -fx-border-color:#e8ecf0; -fx-border-width:1 0 0 0;">
                <Button text="✖  Annuler" onAction="#goBack"
                        style="-fx-background-color:#f0f4f8; -fx-text-fill:#555;
                               -fx-font-size:13px; -fx-font-weight:bold;
                               -fx-background-radius:8; -fx-cursor:hand;
                               -fx-padding:12 28; -fx-border-color:#dce3ea;
                               -fx-border-radius:8;"/>
                <Button text="💾  Enregistrer l'événement" onAction="#saveEvenement"
                        style="-fx-background-color:linear-gradient(to right,#1f4f65,#2e7d9e);
                               -fx-text-fill:white; -fx-font-size:13px;
                               -fx-font-weight:bold; -fx-background-radius:8;
                               -fx-cursor:hand; -fx-padding:12 32;
                               -fx-effect:dropshadow(gaussian,rgba(31,79,101,0.4),10,0,0,3);"/>
            </HBox>

        </VBox>
    </ScrollPane>
</StackPane>
