<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.ExamenController"
      spacing="25"
      prefWidth="1000"
      prefHeight="700"
      styleClass="dashboard-content"
      stylesheets="@../css/dashboard.css">

    <!-- ===== STAT CARDS ===== -->
    <HBox spacing="20" fillHeight="true">
        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="◈" styleClass="stat-icon-green"/>
                <VBox spacing="4">
                    <Label fx:id="lblFacileCount" text="0" styleClass="stat-number"/>
                    <Label text="Examens Faciles" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="◎" styleClass="stat-icon-amber"/>
                <VBox spacing="4">
                    <Label fx:id="lblMoyenCount" text="0" styleClass="stat-number"/>
                    <Label text="Examens Moyens" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="▲" styleClass="stat-icon-red"/>
                <VBox spacing="4">
                    <Label fx:id="lblDifficileCount" text="0" styleClass="stat-number"/>
                    <Label text="Examens Difficiles" styleClass="stat-label"/>
                </VBox>
            </HBox>
        </VBox>
    </HBox>

    <!-- ===== BARRE ACTIONS EXAMENS ===== -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="searchField"
                   promptText="Rechercher un examen..."
                   HBox.hgrow="ALWAYS"
                   styleClass="search-input"
                   onKeyReleased="#handleSearch"/>
        <Button text="🔍" styleClass="search-btn" onAction="#handleSearch"/>
        <Button text="+ Ajouter un Examen" styleClass="btn-primary" onAction="#showAddExamen"/>
    </HBox>

    <!-- ===== FILTRES ===== -->
    <HBox spacing="8" alignment="CENTER_LEFT">
        <ToggleButton fx:id="tabTous"      text="Tous"     styleClass="tab-btn,active" onAction="#filterTous"/>
        <ToggleButton fx:id="tabFacile"    text="Facile"   styleClass="tab-btn"        onAction="#filterFacile"/>
        <ToggleButton fx:id="tabMoyen"     text="Moyen"    styleClass="tab-btn"        onAction="#filterMoyen"/>
        <ToggleButton fx:id="tabDifficile" text="Difficile" styleClass="tab-btn"       onAction="#filterDifficile"/>
    </HBox>

    <!-- ===== TABLE DES EXAMENS ===== -->
    <VBox styleClass="section-box" spacing="0" VBox.vgrow="ALWAYS">
        <TableView fx:id="examenTable"
                   styleClass="parcels-table"
                   VBox.vgrow="ALWAYS"
                   maxWidth="Infinity"
                   prefHeight="420">
            <columns>
                <TableColumn fx:id="colId"          text="ID"           prefWidth="50"/>
                <TableColumn fx:id="colTitre"       text="Titre"        prefWidth="160"/>
                <TableColumn fx:id="colMatiere"     text="Matière"      prefWidth="120"/>
                <TableColumn fx:id="colNiveau"      text="Niveau"       prefWidth="90"/>
                <TableColumn fx:id="colDateDebut"   text="Date Début"   prefWidth="110"/>
                <TableColumn fx:id="colDateFin"     text="Date Fin"     prefWidth="110"/>
                <TableColumn fx:id="colDuree"       text="Durée (min)"  prefWidth="90"/>
                <TableColumn fx:id="colNbQuestions" text="Nb Questions" prefWidth="95"/>
                <TableColumn fx:id="colScoreTotal"  text="Score Total"  prefWidth="85"/>
                <TableColumn fx:id="colType"        text="Type"         prefWidth="90"/>
                <TableColumn fx:id="colEtat"        text="État"         prefWidth="90"/>
                <TableColumn fx:id="colActions"     text="Actions"      prefWidth="260"/>
            </columns>
            <placeholder>
                <Label text="Aucun examen trouvé." styleClass="stat-label"/>
            </placeholder>
        </TableView>
    </VBox>

</VBox>