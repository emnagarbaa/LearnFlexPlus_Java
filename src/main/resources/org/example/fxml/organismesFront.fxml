<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.OrganismesFrontController"
      prefWidth="1200" prefHeight="850"
      style="-fx-background-color:#f8f9fa;">

    <!-- ===== HEADER ===== -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color:#1f4f65; -fx-padding:15 40 15 40;">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <ImageView fx:id="logo" fitHeight="45" fitWidth="45"
                       pickOnBounds="true" preserveRatio="true"
                       onMouseClicked="#switchToBack" style="-fx-cursor:hand;"/>
            <Label text="LearnFlex+"
                   style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:white;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="5" alignment="CENTER">
            <Button text="Accueil"       onAction="#goToAccueil"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-font-size:13px; -fx-cursor:hand; -fx-padding:6 12;"/>
            <Button text="Cours"         onAction="#goToCours"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-font-size:13px; -fx-cursor:hand; -fx-padding:6 12;"/>
            <Button text="Évaluation"    onAction="#goToEvaluation"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-font-size:13px; -fx-cursor:hand; -fx-padding:6 12;"/>
            <Button text="Questionnaire" onAction="#goToQuestionnaire"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-font-size:13px; -fx-cursor:hand; -fx-padding:6 12;"/>
            <Button text="Orientation"   onAction="#goToOrientation"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-font-size:13px; -fx-cursor:hand; -fx-padding:6 12;"/>
            <Button text="Forum"         onAction="#goToForum"
                    style="-fx-background-color:transparent; -fx-text-fill:white;
                           -fx-font-size:13px; -fx-cursor:hand; -fx-padding:6 12;"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔐  Connexion" onAction="#goToConnexion"
                style="-fx-background-color:white; -fx-text-fill:#1f4f65;
                       -fx-font-weight:bold; -fx-background-radius:20;
                       -fx-cursor:hand; -fx-padding:8 18;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                style="-fx-background:transparent; -fx-background-color:transparent;">
        <VBox spacing="0">

            <!-- ══ HERO ══════════════════════════════════════════════════ -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-background-color:linear-gradient(to bottom right,#97c3a2,#1f4f65);
                         -fx-padding:56 40 72 40;">
                <Button text="📅  Voir événements" onAction="#goToEvenements"
                        style="-fx-background-color:rgba(255,255,255,0.18);
                               -fx-text-fill:white; -fx-font-size:14px; -fx-font-weight:bold;
                               -fx-border-color:rgba(255,255,255,0.5); -fx-border-radius:14;
                               -fx-background-radius:14; -fx-padding:10 22; -fx-cursor:hand;"/>
                <Label text="🏢  Organismes disponibles"
                       style="-fx-font-size:34px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Label text="Découvrez les établissements et partenaires qui proposent formations et événements"
                       style="-fx-font-size:16px; -fx-text-fill:rgba(255,255,255,0.88);"/>
            </VBox>

            <!-- ══ CARDS GRID ═════════════════════════════════════════════ -->
            <VBox fx:id="cardsWrapper"
                  style="-fx-padding:0 32 40 32; -fx-background-color:#f8f9fa;">
                <VBox.margin><Insets top="-28"/></VBox.margin>

                <HBox fx:id="firstRow" spacing="24" style="-fx-padding:0 0 24 0;"/>

                <VBox fx:id="emptyBox" alignment="CENTER" spacing="16"
                      style="-fx-background-color:white; -fx-background-radius:20;
                             -fx-border-color:#97c3a2; -fx-border-style:dashed;
                             -fx-border-width:2; -fx-border-radius:20;
                             -fx-padding:80 40;" visible="false" managed="false">
                    <Label text="🏢" style="-fx-font-size:48px;"/>
                    <Label text="Aucun organisme disponible"
                           style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1a1a2e;"/>
                    <Label text="Consultez-nous plus tard pour découvrir nos partenaires"
                           style="-fx-font-size:14px; -fx-text-fill:#666;"/>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>