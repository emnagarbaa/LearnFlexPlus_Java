<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.AjouterCommentaireController"
      spacing="15" style="-fx-padding:20; -fx-min-width:400;">

    <Label text="Commentaire" style="-fx-font-size:16px; -fx-font-weight:bold;"/>

    <Label text="Contenu :"/>
    <TextArea fx:id="fieldContenu" prefRowCount="4" wrapText="true"/>

    <Label text="Auteur :"/>
    <TextField fx:id="fieldAuteur"/>

    <Label fx:id="lblErreur" style="-fx-text-fill:red;"/>

    <HBox spacing="10">
        <Button text="Enregistrer" onAction="#handleEnregistrer"
                style="-fx-background-color:#007bff; -fx-text-fill:white; -fx-font-weight:bold; -fx-padding:8 20; -fx-background-radius:5;"/>
        <Button text="Annuler" onAction="#handleAnnuler"
                style="-fx-padding:8 20; -fx-background-radius:5;"/>
    </HBox>

</VBox>