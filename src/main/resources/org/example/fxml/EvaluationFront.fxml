<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.EvaluationFrontController"
      prefWidth="1200" prefHeight="900"
      stylesheets="@../css/front.css">

    <!-- ===== HEADER ===== -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="15">
        <padding><Insets top="15" right="40" bottom="15" left="40"/></padding>
        <Label text="LearnFlex+"
               style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:white; -fx-cursor:hand;"
               onMouseClicked="#goToAccueil"/>
        <Region HBox.hgrow="ALWAYS"/>
        <HBox spacing="5" alignment="CENTER">
            <Button text="Accueil"       styleClass="nav-btn" onAction="#goToAccueil"/>
            <Button text="Cours"         styleClass="nav-btn" onAction="#goToCours"/>
            <Button text="Évaluation"
                    style="-fx-background-color:rgba(255,255,255,0.25); -fx-text-fill:white;
                           -fx-background-radius:20; -fx-border-radius:20;
                           -fx-border-color:white; -fx-border-width:1;
                           -fx-padding:6 14; -fx-cursor:hand; -fx-font-size:13px;"
                    onAction="#goToEvaluation"/>
            <Button text="Questionnaire" styleClass="nav-btn" onAction="#goToQuestionnaire"/>
            <Button text="Orientation"   styleClass="nav-btn" onAction="#goToOrientation"/>
            <Button text="Forum"         styleClass="nav-btn" onAction="#goToForum"/>
        </HBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔐  Connexion" styleClass="btn-primary" onAction="#goToConnexion"/>
    </HBox>

    <!-- ===== SCROLL PRINCIPAL ===== -->
    <ScrollPane VBox.vgrow="ALWAYS"
                fitToWidth="true"
                fitToHeight="false"
                hbarPolicy="NEVER"
                vbarPolicy="ALWAYS"
                pannable="true"
                style="-fx-background:transparent; -fx-background-color:transparent;
                       -fx-border-color:transparent; -fx-focus-color:transparent;
                       -fx-faint-focus-color:transparent;">

        <VBox spacing="0" minHeight="1200">

            <!-- ===== HERO BANNER ===== -->
            <VBox alignment="CENTER" spacing="12"
                  style="-fx-background-color:#0f3d4f; -fx-padding:50 80 40 80;">
                <Label text="🏆" style="-fx-font-size:48px;"/>
                <Label text="Challenges disponibles"
                       style="-fx-font-size:32px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Label text="Choisis ton challenge, relève le défi et gagne des récompenses !"
                       style="-fx-font-size:15px; -fx-text-fill:rgba(255,255,255,0.8);"/>

                <!-- Stats rapides -->
                <HBox spacing="40" alignment="CENTER" style="-fx-padding:20 0 0 0;">
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color:rgba(255,255,255,0.15);
                                 -fx-background-radius:12; -fx-padding:14 28 14 28;">
                        <Label fx:id="lblTotalChallenges" text="—"
                               style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                        <Label text="Challenges actifs"
                               style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.7);"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color:rgba(255,255,255,0.15);
                                 -fx-background-radius:12; -fx-padding:14 28 14 28;">
                        <Label text="3"
                               style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                        <Label text="Niveaux"
                               style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.7);"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="4"
                          style="-fx-background-color:rgba(255,255,255,0.15);
                                 -fx-background-radius:12; -fx-padding:14 28 14 28;">
                        <Label text="🎁" style="-fx-font-size:26px;"/>
                        <Label text="Récompenses"
                               style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.7);"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ===== BARRE FILTRES ===== -->
            <HBox spacing="12" alignment="CENTER"
                  style="-fx-background-color:#ffffff;
                         -fx-padding:18 80 18 80;
                         -fx-border-color:#e8e8e8;
                         -fx-border-width:0 0 1 0;">
                <Label text="Filtrer par niveau :"
                       style="-fx-font-size:13px; -fx-text-fill:#666; -fx-font-weight:bold;"/>
                <Button text="Tous" fx:id="btnTous"
                        style="-fx-background-color:#1D9E75; -fx-text-fill:white;
                               -fx-background-radius:20; -fx-border-radius:20;
                               -fx-padding:7 20; -fx-cursor:hand; -fx-font-size:13px;"
                        onAction="#filtrerTous"/>
                <Button text="🟢  Facile" fx:id="btnFacile"
                        style="-fx-background-color:white; -fx-text-fill:#3B6D11;
                               -fx-background-radius:20; -fx-border-radius:20;
                               -fx-border-color:#c0dba0; -fx-border-width:1.5;
                               -fx-padding:7 20; -fx-cursor:hand; -fx-font-size:13px;"
                        onAction="#filtrerFacile"/>
                <Button text="🟡  Moyen" fx:id="btnMoyen"
                        style="-fx-background-color:white; -fx-text-fill:#854F0B;
                               -fx-background-radius:20; -fx-border-radius:20;
                               -fx-border-color:#f5c97a; -fx-border-width:1.5;
                               -fx-padding:7 20; -fx-cursor:hand; -fx-font-size:13px;"
                        onAction="#filtrerMoyen"/>
                <Button text="🔴  Difficile" fx:id="btnDifficile"
                        style="-fx-background-color:white; -fx-text-fill:#A32D2D;
                               -fx-background-radius:20; -fx-border-radius:20;
                               -fx-border-color:#f5a0a0; -fx-border-width:1.5;
                               -fx-padding:7 20; -fx-cursor:hand; -fx-font-size:13px;"
                        onAction="#filtrerDifficile"/>
            </HBox>

            <!-- ===== GRILLE CARTES ===== -->
            <VBox VBox.vgrow="ALWAYS"
                  style="-fx-background-color:#f4f8f7; -fx-padding:30 80 50 80;">
                <FlowPane fx:id="cardsContainer"
                          hgap="28" vgap="28"
                          prefWrapLength="1000"
                          alignment="TOP_LEFT"/>
            </VBox>

        </VBox>
    </ScrollPane>

</VBox>