<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.QuizFrontController"
      stylesheets="@../css/front.css">

    <!-- ================= HEADER ================= -->
    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="15">
        <padding><Insets top="15" right="40" bottom="15" left="40"/></padding>

        <Label text="LearnFlex+"
               style="-fx-font-size:22px; -fx-font-weight:bold; -fx-text-fill:white; -fx-cursor:hand;"
               onMouseClicked="#goToAccueil"/>

        <Region HBox.hgrow="ALWAYS"/>

        <HBox spacing="5" alignment="CENTER">
            <Button text="Accueil"       styleClass="nav-btn" onAction="#goToAccueil"/>
            <Button text="Cours"         styleClass="nav-btn" onAction="#goToCours"/>
            <Button text="Évaluation"    styleClass="nav-btn" onAction="#goToEvaluation"/>
            <Button text="Questionnaire"
                    style="-fx-background-color:rgba(255,255,255,0.25);
                           -fx-text-fill:white;
                           -fx-background-radius:20;
                           -fx-border-radius:20;
                           -fx-border-color:white;
                           -fx-border-width:1;
                           -fx-padding:6 14;"/>
            <Button text="Orientation"   styleClass="nav-btn" onAction="#goToOrientation"/>
            <Button text="Forum"         styleClass="nav-btn" onAction="#goToForum"/>
        </HBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="🔐 Connexion" styleClass="btn-primary" onAction="#goToConnexion"/>
    </HBox>

    <!-- ================= CONTENU PRINCIPAL ================= -->
    <HBox VBox.vgrow="ALWAYS">

        <!-- ===== MAIN QUIZ (colonne gauche) ===== -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS"
                    style="-fx-background:transparent; -fx-background-color:transparent;">

            <VBox spacing="20" style="-fx-padding:30; -fx-background-color:#f0f4fa;">

                <!-- HERO / EN-TÊTE DU QUIZ -->
                <VBox alignment="CENTER" spacing="12"
                      style="-fx-background-color:linear-gradient(to right, #081624, #0f3d4f);
                             -fx-padding:25;
                             -fx-background-radius:15;">

                    <Label fx:id="lblTitre"
                           text="Quiz"
                           style="-fx-font-size:24px;
                                  -fx-text-fill:white;
                                  -fx-font-weight:bold;"/>

                    <!-- BARRE DE PROGRESSION -->
                    <HBox alignment="CENTER_LEFT" spacing="10" maxWidth="500">
                        <ProgressBar fx:id="progressBar"
                                     progress="0"
                                     prefWidth="400"
                                     style="-fx-accent:#52c41a;
                                            -fx-background-radius:10;
                                            -fx-pref-height:8;"/>
                        <Label fx:id="lblProgression"
                               text="1 / 1"
                               style="-fx-text-fill:rgba(255,255,255,0.8);
                                      -fx-font-size:13px;"/>
                    </HBox>

                    <!-- TIMER -->
                    <HBox alignment="CENTER" spacing="8">
                        <Label text="⏱"
                               style="-fx-font-size:16px;"/>
                        <Label fx:id="lblTimer"
                               text="05:00"
                               style="-fx-font-size:18px;
                                      -fx-font-weight:bold;
                                      -fx-text-fill:#ff4d4f;
                                      -fx-background-color:white;
                                      -fx-padding:5 14;
                                      -fx-background-radius:20;"/>
                    </HBox>
                </VBox>

                <!-- CARTE QUESTION -->
                <VBox spacing="15"
                      style="-fx-background-color:white;
                             -fx-padding:25;
                             -fx-background-radius:15;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,3);">

                    <Label text="QUESTION"
                           style="-fx-text-fill:#888;
                                  -fx-font-size:11px;
                                  -fx-font-weight:bold;"/>

                    <Label fx:id="lblQuestion"
                           wrapText="true"
                           style="-fx-font-size:18px;
                                  -fx-font-weight:bold;
                                  -fx-text-fill:#142341;"/>

                    <!-- CONTENEUR DES RÉPONSES (rempli dynamiquement par le contrôleur) -->
                    <VBox fx:id="reponseContainer" spacing="10"/>

                    <!-- BOUTON VALIDER -->
                    <Button fx:id="btnValider"
                            text="✅  Valider ma réponse"
                            onAction="#validerReponse"
                            style="-fx-background-color:#52c41a;
                                   -fx-text-fill:white;
                                   -fx-font-weight:bold;
                                   -fx-font-size:14px;
                                   -fx-padding:12 20;
                                   -fx-background-radius:10;
                                   -fx-cursor:hand;"
                            maxWidth="Infinity"/>
                </VBox>

                <!-- ALERTE TEMPS ÉCOULÉ (caché par défaut) -->
                <Label fx:id="lblAlerteTemps"
                       text="⏰ Le temps est écoulé ! Quiz terminé."
                       visible="false"
                       managed="false"
                       style="-fx-background-color:rgba(220,53,69,0.9);
                              -fx-text-fill:white;
                              -fx-padding:10 20;
                              -fx-background-radius:8;
                              -fx-font-size:15px;
                              -fx-font-weight:bold;"/>

            </VBox>
        </ScrollPane>

        <!-- ===== COLONNE HISTORIQUE DES RÉPONSES (droite) ===== -->
        <VBox prefWidth="320" minWidth="280"
              style="-fx-background-color:#f8fafc;
                     -fx-border-color:#e0e7ef;
                     -fx-border-width:0 0 0 1;
                     -fx-padding:20;">

            <Label text="📋  Vos réponses"
                   style="-fx-font-size:14px;
                          -fx-font-weight:bold;
                          -fx-text-fill:#555;
                          -fx-padding:0 0 12 0;"/>

            <Separator style="-fx-padding:0 0 12 0;"/>

            <!-- Liste scrollable de l'historique -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:transparent;
                               -fx-background-color:transparent;">
                <!-- Rempli dynamiquement par le contrôleur via fx:id -->
                <VBox fx:id="historiqueContainer" spacing="10" style="-fx-padding:4 0;"/>
            </ScrollPane>

            <!-- Compteur score en bas de la colonne -->
            <Separator style="-fx-padding:10 0 8 0;"/>
            <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding:8 0 0 0;">
                <Label text="Score :"
                       style="-fx-font-size:13px; -fx-text-fill:#888;"/>
                <Label fx:id="lblScore"
                       text="0 / 0"
                       style="-fx-font-size:16px;
                              -fx-font-weight:bold;
                              -fx-text-fill:#142341;"/>
            </HBox>
        </VBox>

    </HBox>

    <!-- ================= FOOTER ================= -->
    <HBox alignment="CENTER"
          style="-fx-background-color:#0f3d4f; -fx-padding:15;">
        <Label text="© 2026 LearnFlex+ — Quiz Module"
               style="-fx-text-fill:white; -fx-font-size:13px;"/>
    </HBox>

</VBox>
