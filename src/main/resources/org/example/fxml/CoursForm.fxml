<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CoursFormController"
      spacing="15" style="-fx-background-color: #f8fafc; -fx-padding: 20;"
      prefWidth="700" VBox.vgrow="ALWAYS">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Button text="← Retour" onAction="#goBack"
                style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-cursor: hand; -fx-font-weight: bold;"/>
        <Label fx:id="formTitle" text="Ajouter un cours" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
    </HBox>

    <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);" 
          VBox.vgrow="ALWAYS">
        
        <VBox spacing="6">
            <Label text="Titre du cours *" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
            <TextField fx:id="tfTitre" promptText="Ex: Introduction à Java" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
            <Label fx:id="errTitre" text="Le titre est requis" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Description *" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
            <TextArea fx:id="taDesc" promptText="Décrivez le contenu du cours..." prefRowCount="3" wrapText="true" style="-fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
            <Label fx:id="errDesc" text="La description est requise" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
        </VBox>

        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Section / Chapitre *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" minWidth="150"/>
                <TextField fx:id="tfSection" promptText="Ex: Chapitre 1" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                <Label fx:id="errSection" text="La section est requise" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Durée *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" minWidth="100"/>
                <TextField fx:id="tfDuree" promptText="Ex: 2h 30min" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                <Label fx:id="errDuree" text="La durée est requise" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Prix (USD) *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" minWidth="100"/>
                <TextField fx:id="tfPrix" promptText="Ex: 19.99" style="-fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                <Label fx:id="errPrix" text="Prix invalide" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Langue *" style="-fx-font-weight: bold; -fx-text-fill: #475569;" minWidth="100"/>
                <ComboBox fx:id="cbLangue" maxWidth="Infinity" style="-fx-padding: 5; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
                <Label fx:id="errLangue" text="Veuillez choisir une langue" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Matière associée *" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
            <ComboBox fx:id="cbMatiere" maxWidth="Infinity" style="-fx-padding: 5; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;"/>
            <Label fx:id="errMatiere" text="Une matière doit être sélectionnée" textFill="#ef4444" visible="false" managed="false" style="-fx-font-size: 11px;"/>
        </VBox>

        <HBox spacing="15">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Image" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <Button text="📸 Image" onAction="#chooseImage" maxWidth="Infinity"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
                <Label fx:id="lblImageName" text="Aucune image" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Fichier PDF" style="-fx-font-weight: bold; -fx-text-fill: #475569;" minWidth="120"/>
                <Button text="📄 PDF" onAction="#choosePdf" maxWidth="Infinity"
                        style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
                <Label fx:id="lblPdfName" text="Aucun PDF" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>
            </VBox>
        </HBox>

        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
            <Button text="Annuler" onAction="#goBack"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748b; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Enregistrer le cours" onAction="#saveCours"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>

    </VBox>

</VBox>
