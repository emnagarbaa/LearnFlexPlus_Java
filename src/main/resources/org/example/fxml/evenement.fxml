<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.EvenementController"
      spacing="0" style="-fx-background-color:#f4f6f9;">

    <!-- ══ TOOLBAR ══════════════════════════════════════════════════ -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color:#ffffff; -fx-border-color:#e0e0e0;
                 -fx-border-width:0 0 1 0; -fx-padding:14 20 14 20;">

        <Label text="📅  Événements"
               style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill:#1f4f65;"/>
        <Region HBox.hgrow="ALWAYS"/>

        <TextField fx:id="searchField" promptText="🔍  Rechercher par titre…"
                   prefWidth="220" onKeyReleased="#onSearch"
                   style="-fx-background-radius:20; -fx-border-radius:20;
                          -fx-border-color:#ccc; -fx-padding:6 12;"/>

        <Button text="▲ Capacité" onAction="#sortAsc"
                style="-fx-background-color:#e8f4fd; -fx-border-color:#b8d9f0;
                       -fx-background-radius:6; -fx-cursor:hand; -fx-padding:6 12;"/>
        <Button text="▼ Capacité" onAction="#sortDesc"
                style="-fx-background-color:#fef9e7; -fx-border-color:#f0d9a0;
                       -fx-background-radius:6; -fx-cursor:hand; -fx-padding:6 12;"/>

        <Button text="＋  Ajouter" onAction="#openAddPage"
                style="-fx-background-color:#1f4f65; -fx-text-fill:white;
                       -fx-font-weight:bold; -fx-background-radius:6;
                       -fx-cursor:hand; -fx-padding:8 16;"/>
    </HBox>

    <!-- ══ TABLE ════════════════════════════════════════════════════ -->
    <TableView fx:id="table" VBox.vgrow="ALWAYS"
               style="-fx-background-color:transparent;">
        <columns>
            <TableColumn fx:id="colId"          text="ID"          prefWidth="40"/>
            <TableColumn fx:id="colTitre"        text="Titre"       prefWidth="130"/>
            <TableColumn fx:id="colLieu"         text="Lieu"        prefWidth="90"/>
            <TableColumn fx:id="colMode"         text="Mode"        prefWidth="80"/>
            <TableColumn fx:id="colCapacite"     text="Capacité"    prefWidth="70"/>
            <TableColumn fx:id="colDateDebut"    text="Début"       prefWidth="120"/>
            <TableColumn fx:id="colDateFin"      text="Fin"         prefWidth="120"/>
            <TableColumn fx:id="colPublicCible"  text="Public"      prefWidth="90"/>
            <TableColumn fx:id="colOrganisme"    text="Organisme"   prefWidth="110"/>
            <TableColumn fx:id="colEmail"        text="Email"       prefWidth="140"/>
            <TableColumn fx:id="colTelephone"    text="Tél."        prefWidth="100"/>
            <TableColumn fx:id="colActions" text="Actions" minWidth="200" />
        </columns>
        <placeholder>
            <Label text="Aucun événement trouvé."
                   style="-fx-text-fill:#888; -fx-font-size:14px;"/>
        </placeholder>
    </TableView>

    <!-- ══ EDIT DIALOG OVERLAY (modification uniquement) ════════════ -->
    <StackPane fx:id="dialogOverlay" visible="false" managed="false"
               style="-fx-background-color:rgba(0,0,0,0.45);">
        <VBox.margin><Insets/></VBox.margin>

        <VBox maxWidth="600" spacing="16"
              style="-fx-background-color:white; -fx-background-radius:10;
                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.25),20,0,0,4);
                     -fx-padding:28;">

            <Label fx:id="dialogTitle" text="✏️  Modifier l'événement"
                   style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#1f4f65;"/>

            <GridPane hgap="14" vgap="11">
                <columnConstraints>
                    <ColumnConstraints minWidth="140" prefWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Titre *"              GridPane.rowIndex="0"  GridPane.columnIndex="0" style="-fx-font-weight:bold;"/>
                <TextField fx:id="fTitre"          GridPane.rowIndex="0"  GridPane.columnIndex="1" promptText="Titre de l'événement"/>

                <Label text="Lieu"                 GridPane.rowIndex="1"  GridPane.columnIndex="0"/>
                <TextField fx:id="fLieu"           GridPane.rowIndex="1"  GridPane.columnIndex="1" promptText="Lieu"/>

                <Label text="Mode *"               GridPane.rowIndex="2"  GridPane.columnIndex="0" style="-fx-font-weight:bold;"/>
                <ComboBox fx:id="fMode" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Capacité Max"         GridPane.rowIndex="3"  GridPane.columnIndex="0"/>
                <TextField fx:id="fCapaciteMax"    GridPane.rowIndex="3"  GridPane.columnIndex="1" promptText="0"/>

                <Label text="Date Début"           GridPane.rowIndex="4"  GridPane.columnIndex="0"/>
                <TextField fx:id="fDateDebut"      GridPane.rowIndex="4"  GridPane.columnIndex="1" promptText="yyyy-MM-dd HH:mm"/>

                <Label text="Date Fin"             GridPane.rowIndex="5"  GridPane.columnIndex="0"/>
                <TextField fx:id="fDateFin"        GridPane.rowIndex="5"  GridPane.columnIndex="1" promptText="yyyy-MM-dd HH:mm"/>

                <Label text="Public Cible"         GridPane.rowIndex="6"  GridPane.columnIndex="0"/>
                <TextField fx:id="fPublicCible"    GridPane.rowIndex="6"  GridPane.columnIndex="1" promptText="Ex: Étudiants"/>

                <Label text="Organisme"            GridPane.rowIndex="7"  GridPane.columnIndex="0"/>
                <ComboBox fx:id="fOrganisme" maxWidth="Infinity" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                <Label text="Email Contact"        GridPane.rowIndex="8"  GridPane.columnIndex="0"/>
                <TextField fx:id="fContactEmail"   GridPane.rowIndex="8"  GridPane.columnIndex="1" promptText="email@exemple.com"/>

                <Label text="Tél. Contact"         GridPane.rowIndex="9"  GridPane.columnIndex="0"/>
                <TextField fx:id="fContactTelephone" GridPane.rowIndex="9" GridPane.columnIndex="1" promptText="+216 XX XXX XXX"/>

                <Label text="Lien Inscription"     GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <TextField fx:id="fLienInscription" GridPane.rowIndex="10" GridPane.columnIndex="1" promptText="https://..."/>

                <Label text="Description"          GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                <TextArea fx:id="fDescription" prefRowCount="3" GridPane.rowIndex="11" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Annuler" onAction="#closeDialog"
                        style="-fx-background-color:#e0e0e0; -fx-background-radius:6;
                               -fx-padding:8 20; -fx-cursor:hand;"/>
                <Button text="💾  Enregistrer" onAction="#saveEvenement"
                        style="-fx-background-color:#1f4f65; -fx-text-fill:white;
                               -fx-font-weight:bold; -fx-background-radius:6;
                               -fx-padding:8 20; -fx-cursor:hand;"/>
            </HBox>
        </VBox>
    </StackPane>

</VBox>
