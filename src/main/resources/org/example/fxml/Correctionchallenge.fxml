<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controllers.CorrectionChallengeController"
      spacing="20" prefWidth="1100" prefHeight="700"
      style="-fx-padding:24; -fx-background-color:#f7f8fa;">

    <!-- ══ COLONNE GAUCHE : Tableau des réponses ══ -->
    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="📋  Réponses à corriger"
                   style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#1a3d4f;"/>
            <Label fx:id="lblInfo"
                   style="-fx-font-size:12px; -fx-text-fill:#888; -fx-padding:4 10;
                          -fx-background-color:#eee; -fx-background-radius:20;"/>
        </HBox>

        <TableView fx:id="table" VBox.vgrow="ALWAYS" style="-fx-background-radius:10;">
            <columns>
                <TableColumn fx:id="colId"        text="ID"          prefWidth="50"/>
                <TableColumn fx:id="colUser"      text="Étudiant"    prefWidth="150"/>
                <TableColumn fx:id="colChallenge" text="Challenge"   prefWidth="130"/>
                <TableColumn fx:id="colDate"      text="Soumis le"   prefWidth="140"/>
                <TableColumn fx:id="colStatut"    text="Statut"      prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="✅ Aucune réponse en attente."
                       style="-fx-text-fill:#888; -fx-font-size:13px;"/>
            </placeholder>
        </TableView>
    </VBox>

    <!-- ══ COLONNE DROITE : Formulaire de correction ══ -->
    <VBox spacing="16" prefWidth="380" minWidth="360"
          style="-fx-background-color:white; -fx-background-radius:14;
                 -fx-padding:24; -fx-border-color:#e0e0e0;
                 -fx-border-radius:14; -fx-border-width:1;">

        <Label text="✏️  Correction"
               style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#1a3d4f;"/>

        <!-- Réponse de l'étudiant (lecture seule) -->
        <VBox spacing="6">
            <Label text="Réponse de l'étudiant"
                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
            <TextArea fx:id="taReponse" prefRowCount="5" wrapText="true"
                      editable="false"
                      style="-fx-background-color:#f7f8fa; -fx-border-color:#e0e0e0;
                             -fx-border-radius:8; -fx-background-radius:8;
                             -fx-font-size:13px;"/>
        </VBox>

        <!-- Statut -->
        <VBox spacing="6">
            <Label text="Décision"
                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
            <ComboBox fx:id="cbStatut" maxWidth="Infinity"
                      style="-fx-background-radius:8; -fx-border-radius:8;"/>
        </VBox>

        <!-- Note /20 -->
        <VBox spacing="6">
            <Label text="Note  (0 – 20)"
                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
            <Spinner fx:id="spinnerNote" maxWidth="Infinity"
                     style="-fx-background-radius:8; -fx-border-radius:8;"/>
        </VBox>

        <!-- Commentaire -->
        <VBox spacing="6" VBox.vgrow="ALWAYS">
            <Label text="Commentaire (optionnel)"
                   style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#555;"/>
            <TextArea fx:id="taCommentaire" prefRowCount="4" wrapText="true"
                      promptText="Laissez un retour à l'étudiant…"
                      style="-fx-border-color:#e0e0e0; -fx-border-radius:8;
                             -fx-background-radius:8; -fx-font-size:13px;"/>
        </VBox>

        <!-- Bouton valider -->
        <Button fx:id="btnValider" text="💾  Enregistrer la correction"
                maxWidth="Infinity" onAction="#sauvegarderCorrection"
                style="-fx-background-color:#1D9E75; -fx-text-fill:white;
                       -fx-font-size:14px; -fx-font-weight:bold;
                       -fx-background-radius:10; -fx-padding:12 0;
                       -fx-cursor:hand;"/>
    </VBox>
</HBox>
