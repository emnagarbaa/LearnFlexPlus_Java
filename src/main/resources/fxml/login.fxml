<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.LoginController"
            style="-fx-background-color: #f5f7fb;">

    <!-- ================= LEFT SIDE ================= -->
    <left>
        <StackPane prefWidth="500"
                   style="-fx-background-color: linear-gradient(to bottom right, #1f4f65, #2e7d9f);">

            <ImageView fx:id="sideImage"
                       fitWidth="500"
                       fitHeight="800"
                       preserveRatio="true"
                       opacity="0.25"/>

            <VBox alignment="CENTER" spacing="10">

                <ImageView fx:id="logoImage"
                           fitWidth="120"
                           preserveRatio="true"/>

                <Label text="LearnFlexPlus"
                       style="-fx-text-fill: white; -fx-font-size: 28px; -fx-font-weight: bold;"/>

                <Label text="Bienvenue sur la plateforme"
                       style="-fx-text-fill: #dfefff; -fx-font-size: 14px;"/>
            </VBox>
        </StackPane>
    </left>

    <!-- ================= RIGHT SIDE ================= -->
    <center>
        <StackPane>

            <VBox spacing="18"
                  alignment="CENTER"
                  maxWidth="420"
                  style="-fx-background-color: white;
                         -fx-padding: 35;
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0.2, 0, 6);">

                <!-- HEADER -->
                <VBox spacing="5" alignment="CENTER">
                    <Label text="Connexion"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1f4f65;"/>

                    <Label text="Connectez-vous pour continuer"
                           style="-fx-text-fill: #777;"/>
                </VBox>

                <!-- EMAIL -->
                <VBox spacing="6">
                    <Label text="Email"/>

                    <HBox spacing="10" style="-fx-alignment: center-left;">
                        <Label text="📧"/>
                        <TextField fx:id="emailField"
                                   promptText="Entrez votre email"
                                   prefHeight="40"
                                   style="-fx-background-radius: 10;"/>
                    </HBox>
                </VBox>

                <!-- PASSWORD -->
                <VBox spacing="6">
                    <Label text="Mot de passe"/>

                    <HBox spacing="10" style="-fx-alignment: center-left;">
                        <Label text="🔒"/>

                        <PasswordField fx:id="passwordField"
                                       prefHeight="40"
                                       style="-fx-background-radius: 10;"/>

                        <TextField fx:id="visiblePasswordField"
                                   visible="false"
                                   managed="false"
                                   prefHeight="40"
                                   style="-fx-background-radius: 10;"/>

                        <Label fx:id="togglePassword"
                               text="👁"
                               style="-fx-cursor: hand; -fx-font-size: 16px;"/>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT">
                        <Label text="Mot de passe oublié?"
                               style="-fx-text-fill: #2e7d9f; -fx-cursor: hand;"
                               onMouseClicked="#goToForgotPassword"/>
                    </HBox>
                </VBox>

                <!-- CAPTCHA -->
                <VBox spacing="5">
                    <Label text="Captcha"/>
                    <Label text="[ hCaptcha ici ]"
                           style="-fx-border-color: #ddd;
                                  -fx-padding: 10;
                                  -fx-background-radius: 8;"/>
                </VBox>

                <!-- LOGIN BUTTON -->
                <Button text="Se connecter"
                        onAction="#login"
                        prefWidth="400"
                        prefHeight="45"
                        style="-fx-background-color: linear-gradient(to right, #1f4f65, #2e7d9f);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;"/>

                <!-- SOCIAL LOGIN -->
                <VBox spacing="10" alignment="CENTER">

                    <Label text="Ou connectez-vous avec"
                           style="-fx-text-fill: #888;"/>

                    <HBox spacing="12" alignment="CENTER">

                        <Button text="Face ID"
                                fx:id="faceAuthBtn"
                                style="-fx-background-color: #1f4f65;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 10;
                                       -fx-padding: 8 15;"/>

                        <Button text="Google"
                                style="-fx-background-color: white;
                                       -fx-border-color: #ddd;
                                       -fx-background-radius: 10;
                                       -fx-padding: 8 15;"/>
                    </HBox>
                </VBox>

                <!-- SIGNUP -->
                <HBox alignment="CENTER">
                    <Label text="Vous n'avez pas de compte ? "/>

                    <Label text="S'inscrire"
                           style="-fx-text-fill: #2e7d9f; -fx-cursor: hand;"
                           onMouseClicked="#goToSignup"/>
                </HBox>

            </VBox>
        </StackPane>
    </center>

</BorderPane>