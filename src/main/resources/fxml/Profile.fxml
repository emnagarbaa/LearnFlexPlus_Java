<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ProfileController"
            style="-fx-background-color: #f5f7fb;">

    <!-- ===== LEFT BRANDING ===== -->
    <left>
        <StackPane prefWidth="340"
                   style="-fx-background-color: linear-gradient(to bottom right, #1f4f65, #2e7d9f);">
            <VBox alignment="CENTER" spacing="20">

                <!-- Profile picture circle -->
                <StackPane>
                    <javafx.scene.shape.Circle fx:id="avatarClip"
                                               radius="60"
                                               style="-fx-fill: rgba(255,255,255,0.15);"/>
                    <ImageView fx:id="profileImageView"
                               fitWidth="120"
                               fitHeight="120"
                               preserveRatio="true"
                               pickOnBounds="true"
                               style="-fx-cursor: hand;"
                               onMouseClicked="#chooseProfileImage"/>
                </StackPane>

                <Label text="Cliquez sur la photo\npour la modifier"
                       style="-fx-text-fill: rgba(255,255,255,0.7);
                              -fx-font-size: 11px;"
                       wrapText="true"
                       alignment="CENTER"/>

                <Label fx:id="lblName"
                       text=""
                       style="-fx-text-fill: white;
                              -fx-font-size: 20px;
                              -fx-font-weight: bold;"/>

                <Label fx:id="lblRole"
                       text=""
                       style="-fx-text-fill: #dfefff;
                              -fx-font-size: 13px;"/>
            </VBox>
        </StackPane>
    </left>

    <!-- ===== RIGHT FORM ===== -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="24"
                  style="-fx-padding: 40 50 40 50;">

                <!-- Title -->
                <Label text="Mon profil"
                       style="-fx-font-size: 24px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #1f4f65;"/>

                <!-- FORM CARD -->
                <VBox spacing="16"
                      style="-fx-background-color: white;
                             -fx-padding: 28;
                             -fx-background-radius: 14;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 14, 0.2, 0, 4);">

                    <!-- Row 1: Nom + Prénom -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nom"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                            <TextField fx:id="txtNom"
                                       promptText="Votre nom"
                                       style="-fx-background-radius: 8; -fx-padding: 9;"/>
                            <Label fx:id="errNom"
                                   style="-fx-text-fill: #c62828; -fx-font-size: 11px;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Prénom"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                            <TextField fx:id="txtPrenom"
                                       promptText="Votre prénom"
                                       style="-fx-background-radius: 8; -fx-padding: 9;"/>
                            <Label fx:id="errPrenom"
                                   style="-fx-text-fill: #c62828; -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Row 2: Age + Téléphone -->
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Âge"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                            <TextField fx:id="txtAge"
                                       promptText="Votre âge"
                                       style="-fx-background-radius: 8; -fx-padding: 9;"/>
                            <Label fx:id="errAge"
                                   style="-fx-text-fill: #c62828; -fx-font-size: 11px;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Téléphone"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                            <TextField fx:id="txtTelephone"
                                       promptText="Ex: 28078748"
                                       style="-fx-background-radius: 8; -fx-padding: 9;"/>
                            <Label fx:id="errTelephone"
                                   style="-fx-text-fill: #c62828; -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>

                    <!-- Email (read-only) -->
                    <VBox spacing="6">
                        <Label text="Email (non modifiable)"
                               style="-fx-font-size: 12px; -fx-text-fill: #999;"/>
                        <TextField fx:id="txtEmail"
                                   editable="false"
                                   style="-fx-background-radius: 8;
                                          -fx-padding: 9;
                                          -fx-background-color: #f0f0f0;
                                          -fx-text-fill: #999;"/>
                    </VBox>

                    <!-- Divider -->
                    <Separator/>

                    <!-- Password section -->
                    <Label text="Changer le mot de passe"
                           style="-fx-font-size: 13px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #1f4f65;"/>

                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Nouveau mot de passe"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                            <PasswordField fx:id="txtNewPassword"
                                           promptText="Laisser vide pour ne pas changer"
                                           style="-fx-background-radius: 8; -fx-padding: 9;"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Confirmer"
                                   style="-fx-font-size: 12px; -fx-text-fill: #555;"/>
                            <PasswordField fx:id="txtConfirmPassword"
                                           promptText="Répétez le mot de passe"
                                           style="-fx-background-radius: 8; -fx-padding: 9;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="errPassword"
                           style="-fx-text-fill: #c62828; -fx-font-size: 11px;"/>

                </VBox>

                <!-- STATUS MESSAGE -->
                <Label fx:id="lblStatus"
                       wrapText="true"
                       style="-fx-font-size: 13px;"/>

                <!-- ACTION BUTTONS -->
                <HBox spacing="12" alignment="CENTER_LEFT">

                    <Button text="💾  Enregistrer"
                            onAction="#saveProfile"
                            style="-fx-background-color: #1f4f65;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-padding: 11 24;
                                   -fx-cursor: hand;"/>

                    <Button text="✖  Annuler"
                            onAction="#goBack"
                            style="-fx-background-color: #e0e0e0;
                                   -fx-text-fill: #444;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 9;
                                   -fx-padding: 11 24;
                                   -fx-cursor: hand;"/>

                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
